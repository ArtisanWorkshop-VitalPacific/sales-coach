# Sales Coach environment. Every key is optional: with none set, the app runs in Demo mode.

# Claude: turns on Brain mode (Claude plays the customer and coaches the debrief).
ANTHROPIC_API_KEY=
# standard (Haiku 5.5 listens, Sonnet 5.5 speaks, Opus 5.5 coaches), max (Opus 5.5 fast mode), economy
SALES_COACH_PRESET=standard

# ElevenLabs: real customer voices. Without it the browser's built-in voices are used.
ELEVENLABS_API_KEY=
# Optional overrides
ELEVENLABS_MODEL_ID=eleven_v4_turbo

# Stripe: turns on checkout in Portal > Billing.
STRIPE_SECRET_KEY=

# Neon Postgres: shared storage across devices (otherwise sessions stay on each device).
DATABASE_URL=

# LiveKit: Live mode (sub-second voice over WebRTC). Requires the agent worker in apps/agent.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ServiceTitan: job context from your next appointment.
SERVICETITAN_CLIENT_ID=
SERVICETITAN_CLIENT_SECRET=
SERVICETITAN_APP_KEY=
SERVICETITAN_TENANT_ID=
SERVICETITAN_ENV=integration
